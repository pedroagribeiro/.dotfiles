{
  "window.commandCenter": true,
  "workbench.productIconTheme": "fluent-icons",
  "workbench.sideBar.location": "right",
  "files.autoSave": "onFocusChange",
  "editor.renderWhitespace": "trailing",
  "editor.cursorStyle": "block",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.inlineSuggest.enabled": true,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 15,
  "editor.experimentalInlineEdit.fontFamily": "JetBrainsMono Nerd Font",
  "editor.inlineSuggest.fontFamily": "JetBrainsMono Nerd Font",
  "editor.suggestFontFamily": "JetBrainsMono Nerd Font",
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "debug.console.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.fontSize": 14.5,
  "prettier.configPath": ".prettierrc",
  "go.toolsManagement.autoUpdate": true,
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[ruby]": {
    "editor.formatOnSave": false
  },
  "workbench.startupEditor": "none",
  "explorer.confirmDelete": false,
  "explorer.autoReveal": false,
  "rubyLsp.rubyExecutablePath": "/usr/bin/ruby",
  "rubyLsp.addonSettings": {},
  "rubyLsp.rubyVersionManager": {
    "identifier": "auto"
  },
  "makefile.configureOnOpen": true,
  "oneDarkPro.italic": false,
  "workbench.iconTheme": "material-icon-theme",
  "rubyLsp.enabledFeatures": {
    // "codeActions": true,
    "diagnostics": true,
    "documentHighlights": true,
    "documentLink": true,
    "documentSymbols": true,
    "foldingRanges": true,
    "formatting": true,
    "hover": true,
    "inlayHint": true,
    "onTypeFormatting": true,
    "selectionRanges": true,
    "semanticHighlighting": true,
    "completion": true,
    "codeLens": true,
    "definition": true,
    "workspaceSymbol": true,
    "signatureHelp": true,
    "typeHierarchy": true
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "workbench.colorTheme": "GitHub Dark"
}
