{
  "window.commandCenter": true,
  "workbench.productIconTheme": "fluent-icons",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.sideBar.location": "right",
  "files.autoSave": "onFocusChange",
  "editor.renderWhitespace": "trailing",
  "editor.cursorStyle": "block",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.inlineSuggest.enabled": true,
  "editor.fontFamily": "GeistMono Nerd Font",
  "editor.fontSize": 16,
  "editor.fontWeight": 550,
  "editor.experimentalInlineEdit.fontFamily": "GeistMono Nerd Font",
  "editor.inlineSuggest.fontFamily": "GeistMono Nerd Font",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "debug.console.fontFamily": "GeistMono Nerd Font",
  "terminal.integrated.fontFamily": "GeistMono Nerd Font",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.fontWeight": 550,
  "prettier.configPath": ".prettierrc",
  "go.toolsManagement.autoUpdate": true,
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "thunder-client.saveToWorkspace": true,
  "workbench.startupEditor": "none",
  "explorer.confirmDelete": false,
  "rubyLsp.rubyExecutablePath": "/usr/bin/ruby",
  "rubyLsp.addonSettings": {},
  "rubyLsp.rubyVersionManager": {
    "identifier": "auto"
  }
}
